# Kopiere diese Datei zu .env (macht start.ps1 automatisch, falls .env fehlt,
# inkl. zufällig generierter Secrets). .env selbst wird nicht committet.

# postgres | mssql - welche Datenbank das Backend aktuell verwendet.
# Beide Container laufen trotzdem immer parallel (siehe docs/02-decisions.md).
DB_PROVIDER=postgres

POSTGRES_DB=milepoint
POSTGRES_USER=milepoint
POSTGRES_PASSWORD=CHANGE_ME

MSSQL_DB=Milepoint
MSSQL_SA_PASSWORD=CHANGE_ME_Str0ng!

JWT_SIGNING_KEY=CHANGE_ME_mindestens_32_zeichen_zufaelliger_wert
JWT_ISSUER=milepoint-api
JWT_AUDIENCE=milepoint-client
JWT_EXPIRY_MINUTES=60

# Wird beim ersten Start automatisch als Login-Konto angelegt (nur falls der
# Username noch nicht existiert). Bewusst fest auf admin/admin für die lokale
# Dev-Umgebung - vor jeder öffentlichen Nutzung ändern.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@milepoint.local
ADMIN_INITIAL_PASSWORD=admin

# Host-Ports - werden von start.ps1 automatisch angepasst, falls belegt.
# CADDY_PORT (HTTP) leitet nur noch auf CADDY_HTTPS_PORT (HTTPS) um, siehe Caddyfile.
CADDY_PORT=80
# 443 wird auf Windows/WSL2 häufig doppelt belegt (Docker Desktop + WSL2-Relay können beide
# binden, was zu kaputten TLS-Handshakes führt statt einem sauberen "Port belegt") - 8443 als
# Default ist zuverlässiger, start.ps1 weicht bei Bedarf trotzdem automatisch weiter aus.
CADDY_HTTPS_PORT=8443
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432
MSSQL_PORT=1433
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
ADMINER_PORT=8081
WHISPER_PORT=9000

# Optional Speech-to-Text-Service (whisper) - läuft nur mit dem "whisper"-Profil
# (docker compose --profile whisper up -d whisper, oder start.ps1 -WithWhisper).
# openai_whisper | faster_whisper | whisperx - faster_whisper (CTranslate2-Backend) statt der
# openai_whisper-Referenzimplementierung, da openai_whisper auf CPU spürbar langsam war (mehrere
# Sekunden pro kurzem Diktat, selbst auf einer starken 16-Kern-CPU) - faster_whisper liefert
# dieselbe Genauigkeit deutlich schneller auf reiner CPU.
WHISPER_ASR_ENGINE=faster_whisper
# tiny | base | small | medium | large-v3 | large-v3-turbo - large-v3-turbo (explizite
# Nutzerpräferenz) liefert nahezu dieselbe Genauigkeit wie large-v3, aber ca. 8x schnellere
# Inferenz dank weniger Decoder-Layern - der bessere Kompromiss für Diktier-Latenz als das volle
# large-v3 ("base" erkannte davor zu viele Wörter falsch).
WHISPER_ASR_MODEL=large-v3-turbo
# cuda | cpu - siehe docker-compose.yml für GPU-Aktivierung.
WHISPER_ASR_DEVICE=cpu
