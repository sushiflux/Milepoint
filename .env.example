# Kopiere diese Datei zu .env (macht start.ps1 automatisch, falls .env fehlt,
# inkl. zufällig generierter Secrets). .env selbst wird nicht committet.

# postgres | mssql - welche Datenbank das Backend aktuell verwendet.
# Beide Container laufen trotzdem immer parallel (siehe docs/02-decisions.md).
DB_PROVIDER=postgres

POSTGRES_DB=pm
POSTGRES_USER=pm
POSTGRES_PASSWORD=CHANGE_ME

MSSQL_DB=PM
MSSQL_SA_PASSWORD=CHANGE_ME_Str0ng!

JWT_SIGNING_KEY=CHANGE_ME_mindestens_32_zeichen_zufaelliger_wert
JWT_ISSUER=pm-api
JWT_AUDIENCE=pm-client
JWT_EXPIRY_MINUTES=60

# Wird beim ersten Start automatisch als Login-Konto angelegt (nur falls der
# Username noch nicht existiert). Passwort wird wie oben zufällig generiert.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pm.local
ADMIN_INITIAL_PASSWORD=CHANGE_ME_Str0ng!

# Wird von start.ps1 bei jedem Start aus VERSION + Git-Commit-Anzahl neu berechnet.
APP_VERSION=dev

# Host-Ports - werden von start.ps1 automatisch angepasst, falls belegt.
CADDY_PORT=80
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432
MSSQL_PORT=1433
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
ADMINER_PORT=8081
