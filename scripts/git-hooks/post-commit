#!/bin/sh
# Keeps backend/src/Milepoint.Api/version.txt (read live by GET /api/version) in sync with
# the actual commit count immediately after every commit - not just whenever start.ps1
# happens to be re-run. Wired up automatically by start.ps1 via `git config core.hooksPath`.
#
# Scheme: Year.Month.Day.CommitCount, no zero-padding (e.g. v2026.8.28.64) - mirrors Fluxo's
# versioning. The date is always "today" at commit time; there's no manually-maintained base
# file to keep in sync (see VERSION, since removed) - just today's date plus the running
# total commit count, which never resets or needs bumping by hand.

root_dir="$(git rev-parse --show-toplevel)"
count="$(git -C "$root_dir" rev-list --count HEAD)"
printf 'v%s.%s' "$(date +%Y.%-m.%-d)" "$count" > "$root_dir/backend/src/Milepoint.Api/version.txt"
