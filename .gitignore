# --- Secrets / local env ---
.env
.env.local
*.local.json

# --- .NET ---
backend/**/bin/
backend/**/obj/
*.user
*.suo

# --- Version stamp (regenerated by start.ps1 / post-commit hook, see scripts/git-hooks) ---
backend/src/Milepoint.Api/version.txt

# --- Node / Vite ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# --- Playwright E2E suite (frontend/e2e/run.mjs npm-installs @playwright/test on demand,
# inside the on-demand Playwright Docker container - see the suite's own README/comments) ---
frontend/e2e/node_modules/
frontend/e2e/package.json
frontend/e2e/package-lock.json
frontend/e2e/test-results/
frontend/e2e/playwright-report/

# --- Editor ---
.vs/
.idea/
.vscode/

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs ---
*.log
npm-debug.log*

# Local DB backups taken before major version upgrades - not for version control
.backups/
