FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /src

COPY Milepoint.sln .
COPY src/Milepoint.Api/Milepoint.Api.csproj src/Milepoint.Api/
RUN dotnet restore src/Milepoint.Api/Milepoint.Api.csproj

COPY . .
WORKDIR /src/src/Milepoint.Api

ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_USE_POLLING_FILE_WATCHER=true
EXPOSE 8080

ENTRYPOINT ["dotnet", "watch", "run", "--no-launch-profile", "--urls", "http://+:8080"]
