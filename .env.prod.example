# Vorlage für docker-compose.prod.yml - Kopie zu .env.prod, echte Werte selbst eintragen
# (kein Auto-Generieren wie bei .env.example - das ist eine Kunden-/Unraid-Installation, nicht
# der lokale Dev-Stack, daher keine start.ps1-Automatik dafür). .env.prod selbst nie committen.

POSTGRES_DB=milepoint
POSTGRES_USER=milepoint
POSTGRES_PASSWORD=CHANGE_ME_ein_echtes_zufaelliges_passwort

# Mindestens 32 zufällige Zeichen - z.B. via
# powershell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
JWT_SIGNING_KEY=CHANGE_ME_mindestens_32_zeichen_zufaelliger_wert
JWT_ISSUER=milepoint-api
JWT_AUDIENCE=milepoint-client
JWT_EXPIRY_MINUTES=60

# Nur beim allerersten Start verwendet, falls dieser Username noch nicht existiert - danach im
# Login-Formular selbst ändern. Fest auf "admin" zu lassen und dieses Initial-Passwort NICHT zu
# ändern wäre ein offenes Login für jeden, der die Installation erreichen kann.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_vor_dem_ersten_Start

# Nötig, damit ein Browser, der Milepoint unter dieser Adresse aufruft, überhaupt mit dem Backend
# reden darf - z.B. https://milepoint.example.com oder https://192.168.1.50:8443. Mehrere Origins
# kommagetrennt.
CORS_ALLOWED_ORIGINS=

# Host-Ports - selbst anpassen, falls einer bereits belegt ist (kein Auto-Fallback in Prod, siehe
# die globale CLAUDE.md's "Port registry"-Konvention: fest zugewiesen, nie stillschweigend
# verschoben).
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
WHISPER_PORT=9000
# Nur relevant, wenn das optionale "caddy"-Profil genutzt wird (siehe docker-compose.prod.yml) -
# die meisten Unraid-Nutzer haben bereits einen eigenen Reverse-Proxy (SWAG/NPM) und lassen das.
CADDY_PORT=80
CADDY_HTTPS_PORT=8443

# Optionaler Speech-to-Text-Service - siehe .env.example für die Erklärung der Werte, identisch.
WHISPER_ASR_ENGINE=faster_whisper
WHISPER_ASR_MODEL=large-v3-turbo
WHISPER_ASR_DEVICE=cpu
