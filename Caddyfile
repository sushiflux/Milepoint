{
	admin off
	# Caddys eigener automatischer HTTP->HTTPS-Redirect (Standardverhalten fuer jede Site mit
	# automatischem HTTPS) kennt den tatsaechlich verwendeten, nicht-standardmaessigen HTTPS-Port
	# (CADDY_HTTPS_PORT) nicht und erzeugt einen eigenen 308-Redirect OHNE Port, der Vorrang vor
	# dem eigenen ":80"-Block unten hat - "disable_redirects" schaltet das ab, damit ausschliesslich
	# der eigene ":80"-Block (der den Port korrekt anhaengt) greift.
	auto_https disable_redirects
}

# Plain HTTP just redirects to HTTPS - CADDY_HTTPS_PORT is whatever start.ps1
# actually mapped on the host (443 by default, or a fallback if that was busy).
:80 {
	redir https://{host}:{$CADDY_HTTPS_PORT}{uri} permanent
}

# Hostname must be explicit (not a bare ":443") - "tls internal" only auto-issues
# a certificate for names it actually knows about from the site address, so a
# hostless block left every TLS ClientHello unmatched ("no certificate available").
# milepoint.localhost is a more memorable alias - ".localhost" is a reserved TLD (RFC 6761)
# that resolves straight to 127.0.0.1 with zero DNS lookup, so it works with no setup at all.
# milepoint.sushifluxdevelop is an optional second alias; it only resolves if a local DNS
# wildcard points *.sushifluxdevelop at 127.0.0.1. The port still has to be in the URL either
# way, since host ports 80/443 are often already taken (e.g. by IIS).
localhost:443, milepoint.localhost:443, milepoint.sushifluxdevelop:443 {
	# No public domain here (this is a local dev stack), so Caddy issues its own
	# locally-trusted certificate instead of requesting one from Let's Encrypt.
	# The browser will only show a green padlock once that internal CA root is
	# trusted on the host - see docs/03-runbook.md for the one-time trust step.
	tls internal

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /hubs/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:5173
	}

	log {
		output stdout
		format console
	}
}
